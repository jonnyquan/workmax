  "wailsShell": {
    "status": "current",
    "description": "The Wails shell replaces preload IPC with a same-origin UI server. Each entry names the guarantee and the file that must still carry it, so retiring Electron does not quietly retire the guarantee with it.",
    "uiServer": "desktop/wails/uiserver.go",
    "shellMain": "desktop/wails/main.go",
    "rendererShim": "desktop/renderer/en/desktop/shim.js",
    "bridgeLibrary": {
      "generated": "desktop/renderer/en/desktop/lib/desktop-bridge.js",
      "source": "desktop/renderer/src/desktop-bridge.ts",
      "generator": "desktop/scripts/build-renderer-lib.sh"
    },
    "exposedGlobals": [
      "workmaxLocal",
      "desktopBridge"
    ],
    "loginGate": {
      "prefix": "/login/",
      "verbs": [
        "begin",
        "status",
        "password",
        "cancel"
      ],
      "note": "Renderer names a verb; Go picks the sidecar route and method. The analogue of Electron's Main-only ipcMain gate."
    },
    "guarantees": [
      {
        "id": "capability-path",
        "why": "The proxy injects the local token, so without a per-launch capability any local process that found the UI port would drive the sidecar with full authority.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "func mintCapability",
            "crypto/rand"
          ]
        }
      },
      {
        "id": "privileged-routes-refused-server-side",
        "why": "The renderer must not be able to name the credential routes; enforced where the renderer cannot reach, unlike preload's in-process guard.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "privilegedSidecarPaths",
            "/auth/login-transaction",
            "/auth/login-transaction/password"
          ]
        }
      },
      {
        "id": "model-gateway-refused-server-side",
        "why": "The model gateway spends the account's membership on behalf of a local agent subprocess. A page that could name it would be able to bill the user directly, skipping every check the agent routes apply — so the whole subtree is refused in the proxy, where the renderer cannot reach around it.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "privilegedSidecarPrefixes",
            "/model-gateway/"
          ]
        }
      },
      {
        "id": "origin-stripped-before-sidecar",
        "why": "Every sidecar route rejects a browser Origin; stripping here keeps that rule as strict as it is rather than relaxing it.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "r.Out.Header.Del(\"Origin\")",
            "r.Out.Header.Set(\"X-Local-Token\", token)"
          ]
        }
      },
      {
        "id": "no-redirect-based-checks",
        "why": "A privileged-route check that only holds if the client follows a 301 is not a check.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "func rejectNonCanonicalPaths"
          ]
        }
      },
      {
        "id": "sse-streams-unbuffered",
        "why": "Agent turns are minutes-long SSE; a buffering proxy would turn streaming into a single late response.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "FlushInterval: -1"
          ]
        }
      },
      {
        "id": "containment-headers",
        "why": "script-src 'self' is what stops model output rendered into the DOM from executing; macOS Wails has no cancellable navigation hook, so CSP is the primary control. No 'unsafe-inline' anywhere: the shipped renderer needs none, and an exemption granted once is never taken back.",
        "evidence": {
          "file": "desktop/wails/uiserver.go",
          "contains": [
            "script-src 'self'",
            "connect-src 'self'",
            "object-src 'none'",
            "frame-ancestors 'none'"
          ],
          "absent": [
            "'unsafe-inline'"
          ]
        }
      },
      {
        "id": "token-never-in-renderer",
        "why": "Decision D4 reversed: the proxy injects the token, so the page cannot read it — matching the Electron preload-closure guarantee.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "absent": [
            "\"X-Local-Token\""
          ],
          "absentNote": "Matched with quotes: using the header from JS requires a string literal, while prose about it does not. Keeps the rule about code, not about whether a comment may name the thing it protects."
        }
      },
      {
        "id": "renderer-globals-installed",
        "why": "renderer.js reaches for exactly these two globals; the shim replaces contextBridge.exposeInMainWorld.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "contains": [
            "window.workmaxLocal =",
            "window.desktopBridge ="
          ]
        }
      },
      {
        "id": "request-hygiene-preserved",
        "why": "Carried over from preload verbatim: no ambient credentials, and a redirect must fail rather than move the request off the checked path.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "contains": [
            "credentials: \"omit\"",
            "redirect: \"error\""
          ]
        }
      },
      {
        "id": "login-through-gate-only",
        "why": "The renderer submits credentials through one shape it does not control, never by naming a sidecar route.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "contains": [
            "function loginVerb",
            "function submitLoginPassword"
          ]
        }
      },
      {
        "id": "turn-cancel-is-local-and-remote",
        "why": "Same rule preload enforced: abort local delivery first, then ask the sidecar, so bytes after cancel cannot reach the renderer.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "contains": [
            "active.cancelRequested = true",
            "active.abortController.abort()",
            "/cancel"
          ]
        }
      },
      {
        "id": "devtools-off-by-default",
        "why": "The window holds an authenticated session and an API the proxy authenticates on its behalf. Devtools must be an explicit development opt-in, never something a packaged build carries or can be talked into enabling.",
        "evidence": {
          "file": "desktop/wails/main.go",
          "contains": [
            "func devToolsRequested()",
            "DevToolsEnabled: devToolsRequested()"
          ],
          "absent": [
            "DevToolsEnabled: true"
          ]
        }
      },
      {
        "id": "external-links-leave-the-window",
        "why": "macOS Wails has no cancellable navigation hook, so an anchor allowed to proceed replaces the app with a remote page and there is no way back. The renderer stops the click; Go re-validates and opens the system browser. Neither half is optional: without the renderer half the navigation happens, without the Go half the page decides what counts as external.",
        "evidence": {
          "file": "desktop/wails/external.go",
          "contains": [
            "func normalizeExternalHTTPURL",
            "func isLocalOrPrivateHost",
            "IsPrivate()",
            "IsLinkLocalUnicast()"
          ]
        }
      },
      {
        "id": "renderer-intercepts-external-clicks",
        "why": "Capture phase, so a handler that stops propagation cannot skip it. The URL is sent to Go rather than opened here, because opening it here is the navigation this exists to prevent.",
        "evidence": {
          "file": "desktop/renderer/en/desktop/shim.js",
          "contains": [
            "function isExternalHref",
            "event.preventDefault()",
            "open-external"
          ]
        }
      }
    ],
    "openExternalPath": "/open-external"
  },
  "privilegedGate": {
    "description": "The one privileged path the renderer cannot reach around. Under Electron this was ipcMain; under Wails it is the Go login gate. The renderer names a verb and never a route or a method.",
    "prefix": "/login/",
    "entries": [
      {
        "id": "auth.begin-login-transaction",
        "verb": "begin",
        "status": "current"
      },
      {
        "id": "auth.login-transaction-status",
